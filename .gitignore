# AI-Based Public Grievance System - Git Ignore File

# ============================================
# Documentation Files
# ============================================
# Ignore all markdown files except README.md
*.md
!README.md

# ============================================
# Python / Backend
# ============================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
venv/
env/
ENV/
.venv/
backend/venv/
backend/env/

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
*.manifest
*.spec

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# Flask
instance/
.webassets-cache
*.db
*.sqlite
*.sqlite3

# Environment variables
.env
.env.local
.env.*.local
backend/.env
frontend/.env

# Logs
*.log
logs/
backend/logs/
*.log.*

# Database files
*.db
*.sqlite
*.sqlite3
backend/instance/
backend/*.db

# ML Models (if large, consider Git LFS)
# backend/ml_models/*.pkl
# backend/ml_models/*.h5
# backend/ml_models/*.model

# Uploads
backend/uploads/*
!backend/uploads/.gitkeep

